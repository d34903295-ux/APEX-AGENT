# ============================================================================
# APEX-AGENT PRO — environment configuration
# Copy to ".env" and fill in. NEVER commit your real .env.
# ============================================================================

# ---- GLOBAL SAFETY -----------------------------------------------------------
# Trading mode: paper | live   (DEFAULT: paper — DO NOT change until validated)
APEX_MODE=paper
# Risk profile: conservative | balanced | aggressive | degen
APEX_RISK_PROFILE=conservative
# Master kill-switch. If false, NO real orders are ever sent, period.
APEX_LIVE_TRADING_ENABLED=false
# Require an explicit human confirmation (via Telegram) before enabling degen.
APEX_DEGEN_REQUIRES_CONFIRMATION=true
# Base currency for accounting
APEX_BASE_CURRENCY=USDT
# Starting paper balance (base currency units)
APEX_PAPER_BALANCE=10000
# User strategy config file (auto-created from your profile on first run).
# Edit it, or change strategies live via Telegram. See docs/CONFIGURATION.md.
APEX_STRATEGY_CONFIG=./data/strategy_config.json

# ---- RISK LIMITS (hard caps, enforced by risk-manager) ----------------------
APEX_MAX_POSITION_PCT=0.10           # max % of equity per single position
APEX_MAX_PORTFOLIO_LEVERAGE=1.0      # 1.0 = no leverage (degen unlocks more)
APEX_MAX_DAILY_DRAWDOWN_PCT=0.05     # auto-pause if breached in a day
APEX_MAX_DEGEN_LEVERAGE=100          # only reachable in degen mode
APEX_MAX_OPEN_POSITIONS=8
APEX_MAX_CORRELATED_EXPOSURE_PCT=0.30

# ---- INFRASTRUCTURE ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# If empty, the bus falls back to an in-process async bus (single-host mode).
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex
# SQLite cache (local, always available)
SQLITE_CACHE_PATH=./data/apex_cache.db

# ---- TELEGRAM ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to control the bot (whitelist).
TELEGRAM_ALLOWED_USER_IDS=
# Shared secret for the /2fa TOTP-style second factor (base32).
TELEGRAM_2FA_SECRET=

# ---- EXCHANGES (CeFi) — leave blank to stay in paper mode -------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---- WALLETS / RPC (DeFi) — keep keys OUT of plaintext in production --------
# Prefer a secrets manager / Vault. These are read at boot and never logged.
ETH_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
SOLANA_RPC_URL=
# Use a dedicated, low-balance "hot" wallet. NEVER your main wallet.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# ---- DATA / NEWS / SENTIMENT (optional) ------------------------------------
TWITTER_BEARER_TOKEN=
NEWS_API_KEY=

# ---- AI / LLM (optional, for the reasoning planner) ------------------------
# Used by the symbolic planner to translate market conditions into strategies.
ANTHROPIC_API_KEY=
APEX_LLM_MODEL=claude-opus-4-8

# ---- DASHBOARD --------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
